# ==========================================================
# Sara AI — Configuration Template (.env.example)
# Rename or copy this file to .env and insert your credentials.
# ==========================================================

# Flask Secret Key & Port
SECRET_KEY=sara-ai-local-secret-key-change-in-production
PORT=5000
FLASK_DEBUG=True

# AI Provider Selection
# TokenMix is the primary replier using gpt-4o-mini
AI_PROVIDER=tokenmix

# TokenMix API (Primary Replier)
TOKENMIX_API_KEY=
TOKENMIX_BASE_URL=https://api.tokenmix.ai/v1
TOKENMIX_API_URL=https://api.tokenmix.ai/v1/chat/completions
TOKENMIX_MODEL=gpt-4o-mini

# Hugging Face Inference API (Fallback)
HF_TOKEN=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HF_API_URL=https://api-inference.huggingface.co/models/
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-dev

# Image Enhancement Configuration
# Options: 'auto', 'pillow' (offline local), 'huggingface'
IMAGE_ENHANCE_PROVIDER=auto

# iLovePDF REST API Credentials (for PDF Compression)
# Obtain your free API keys from: https://developer.ilovepdf.com
ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_PRIVATE_KEY=

# Voice & Speech Settings
TTS_RATE=180
TTS_VOLUME=1.0
SPEECH_LANGUAGE=en-US

# Request Timeout (seconds)
API_TIMEOUT=30
